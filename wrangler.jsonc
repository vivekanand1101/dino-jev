{
  "name": "dino-jev",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "PLAN_RATE_LIMITER",
      "namespace_id": "1101202601",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
